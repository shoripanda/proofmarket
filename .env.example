# ProofMarket environment variables.
# Spec: specs/proofmarket/implementation/ja/02-system-architecture.md §6.2
# Copy to apps/web/.env.local for local development. NEVER commit real values.
# Everything except NEXT_PUBLIC_* is server-only.

# --- Database / Storage (Supabase) ---
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Worker auth (Privy) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# --- Solana (Devnet only; Mainnet is refused at startup) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet genesis hash. The settlement adapter refuses to start if the RPC reports anything else.
SOLANA_EXPECTED_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1
PROGRAM_ID=
# Circle Devnet USDC (6 decimals). See 06-solana-program-design.md §6.
BOUNTY_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# base58-encoded 64-byte secret keys. Disposable Devnet keys only.
OPERATOR_SECRET_KEY=
VERIFIER_SECRET_KEY=

# --- Secrets for app-level crypto ---
# 32 random bytes, base64. Encrypts worker location observations (AES-256-GCM).
LOCATION_ENC_KEY=
# HMAC key for witness_ref in evidence bundles.
WORKER_REF_SALT=
WEBHOOK_SIGNING_SECRET_PEPPER=

# --- Internal / operator ---
INTERNAL_CRON_SECRET=
ADMIN_TOKEN=

# --- Policy ---
# minLat,minLng,maxLat,maxLng of the pilot area
PILOT_BBOX=35.60,139.65,35.72,139.78
# 1 until PR-14 (multi-witness) lands, then 5
MAX_WITNESSES=1

# --- Optional (P1) ---
ANTHROPIC_API_KEY=

# --- Runtime environment: local | preview | demo ---
# The dev settlement stub refuses to start when APP_ENV=demo (10 §3, PR-06).
APP_ENV=local
