{
  "name": "proofmarket",
  "private": true,
  "description": "ProofMarket — real-world fact verification for AI agents (Crypto World's Fair 2026). Specs: specs/proofmarket/",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm --filter @proofmarket/web run build",
    "db:generate": "pnpm --filter @proofmarket/db run generate",
    "db:migrate": "pnpm --filter @proofmarket/db run migrate",
    "openapi": "pnpm --filter @proofmarket/core run openapi",
    "program:build": "anchor build",
    "program:test": "cargo test -p proofmarket"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
